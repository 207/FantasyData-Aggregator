# ESPN Fantasy credentials (optional — demo mode works without these)
# LEAGUE_ID=123456789
# YEAR=2025
# SWID={xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx}
# ESPN_S2=AEAxxxxxxxx...

# Your team name as shown in ESPN (optional; used to highlight "your" roster)
# TEAM_NAME=My Team

# Rankings (Phase 2+)
# RANKINGS_MODE=live          # live | mock — mock skips network and uses built-in FP ranks
# SLEEPER_ENABLED=true        # set false to skip Sleeper API (also skips trending boost for waivers)
# FANTASYPROS_RANKINGS_URL=https://www.fantasypros.com/nfl/rankings/consensus-cheatsheets.php

# Phase 3 trade/waiver recommendations need no extra env vars — they use roster
# snapshots, consensus ranks, ESPN/demo free agents, and Sleeper trending from Refresh.
