# ESPN Fantasy credentials (optional — demo mode works without these)
# LEAGUE_ID=123456789
# YEAR=2026
# SWID={xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx}
# ESPN_S2=AEAxxxxxxxx...

# Your team name as shown in ESPN (optional; used to highlight "your" roster)
# TEAM_NAME=My Team

# Rankings
# RANKINGS_MODE=live          # live | mock
# SLEEPER_ENABLED=true
# FANTASYPROS_RANKINGS_URL=https://www.fantasypros.com/nfl/rankings/ros-ppr-overall.php
# FANTASYPROS_WEEKLY_URL=https://www.fantasypros.com/nfl/rankings/ppr.php
# FUSION_METHOD=rrf           # rrf (default) | mean | median
# FUSION_RRF_K=60             # RRF constant k in Σ 1/(k + rank)

# ---------------------------------------------------------------------------
# LLM recommendations
# Preferred: OpenAI (set your key, then LLM_PROVIDER=openai).
# Fallback:  Google Gemini free tier (LLM_PROVIDER=gemini).
# Never commit real keys.
# ---------------------------------------------------------------------------
LLM_PROVIDER=openai           # openai | gemini | anthropic
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini     # cheap/fast; alternatives: gpt-4.1, gpt-4o-mini

# Gemini fallback (keep keys if you want to switch back with LLM_PROVIDER=gemini)
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=             # or GOOGLE_API_KEY — https://aistudio.google.com/apikey
# GOOGLE_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash   # best free-tier Flash; lite: gemini-3.5-flash-lite

# Shared LLM knobs
# LLM_CONTEXT_FORMAT=toon     # toon (default, fewer tokens / richer pack) | json
# LLM_RETRY_MAX=6             # attempts on 503/high-demand (wait doubles each try)
# LLM_RETRY_BASE_SECONDS=2    # first backoff seconds → 2, 4, 8, 16, …

# Optional Anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-haiku-latest
