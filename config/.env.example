# ESPN Fantasy credentials (optional — demo mode works without these)
# LEAGUE_ID=123456789
# YEAR=2025
# SWID={xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx}
# ESPN_S2=AEAxxxxxxxx...

# Your team name as shown in ESPN (optional; used to highlight "your" roster)
# TEAM_NAME=My Team

# Rankings
# RANKINGS_MODE=live          # live | mock
# SLEEPER_ENABLED=true
# FANTASYPROS_RANKINGS_URL=https://www.fantasypros.com/nfl/rankings/ros-ppr-overall.php
# FANTASYPROS_WEEKLY_URL=https://www.fantasypros.com/nfl/rankings/ppr.php
# FUSION_METHOD=rrf           # rrf (default) | mean | median
# FUSION_RRF_K=60             # RRF constant k in Σ 1/(k + rank)

# LLM recommendations (default: Google Gemini free tier)
# LLM_PROVIDER=gemini         # gemini | openai | anthropic
# GEMINI_API_KEY=             # or GOOGLE_API_KEY — https://aistudio.google.com/apikey
# GOOGLE_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash   # free-tier friendly; try gemini-2.5-flash-lite
# LLM_CONTEXT_FORMAT=toon     # toon (default, fewer tokens / richer pack) | json
#
# Optional cloud providers — YOUR keys only (never commit real keys):
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-haiku-latest
