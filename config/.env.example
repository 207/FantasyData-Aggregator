# ESPN Fantasy credentials (optional — demo mode works without these)
# LEAGUE_ID=123456789
# YEAR=2025
# SWID={xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx}
# ESPN_S2=AEAxxxxxxxx...

# Your team name as shown in ESPN (optional; used to highlight "your" roster)
# TEAM_NAME=My Team

# Rankings
# RANKINGS_MODE=live          # live | mock
# SLEEPER_ENABLED=true
# FANTASYPROS_RANKINGS_URL=https://www.fantasypros.com/nfl/rankings/ros-ppr-overall.php
# FANTASYPROS_WEEKLY_URL=https://www.fantasypros.com/nfl/rankings/ppr.php

# LLM recommendations (default: local Ollama)
# LLM_PROVIDER=ollama         # ollama | openai | anthropic
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.1:8b    # 7B–14B fits a 24GB Mac; try mistral / qwen2.5 etc.
# OLLAMA_NUM_CTX=16384        # REQUIRED: default ~2048 truncates league context
# OLLAMA_NUM_PREDICT=2048     # room for full trades/waivers/start-sit JSON
#
# Optional cloud providers — YOUR keys only (never commit real keys):
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-haiku-latest
#
# Later: point OLLAMA_BASE_URL at a Windows RTX 3070 host for faster ~7B inference.
